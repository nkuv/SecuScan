<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.secuscan.vulnerableapp">

    <!-- OVER-PRIVILEGED APP -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- INTENTIONALLY VULNERABLE CONFIGURATION -->
    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Vulnerable App"
        android:theme="@style/Theme.VulnerableApp"
        android:usesCleartextTraffic="true"> <!-- ALLOWS HTTP INSTEAD OF HTTPS -->

        <!-- EXPOSED INTENT FILTER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- EXPOSED CONTENT PROVIDER -->
        <provider
            android:name=".VulnerableProvider"
            android:authorities="com.secuscan.vulnerableapp.provider"
            android:exported="true" />

    </application>
</manifest>
